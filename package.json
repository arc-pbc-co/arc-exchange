{
  "name": "arc-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-based impact investment marketplace on Polygon",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @arc-exchange/web dev",
    "dev:api": "pnpm --filter @arc-exchange/api dev",
    "build": "pnpm run --parallel build",
    "build:web": "pnpm --filter @arc-exchange/web build",
    "build:api": "pnpm --filter @arc-exchange/api build",
    "lint": "pnpm run --parallel lint",
    "test": "pnpm run --parallel test",
    "clean": "pnpm run --parallel clean && rm -rf node_modules",
    "typecheck": "pnpm run --parallel typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
